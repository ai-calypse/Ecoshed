        "unit": "percent"
      },
      "instances": {
        "definition": "Observed category count; an absent category has no outcome row.",
        "unit": "instances"
      },
      "mean_wait_s": {
        "definition": "Instance-weighted initial wait, including queueing and wake delay.",
        "unit": "seconds"
      },
      "migrated_pct": {
        "definition": "Category instances migrated at least once; not migration count.",
        "unit": "percent"
      },
      "p95_wait_s": {
        "definition": "Within-run 95th percentile; never average across runs or categories.",
        "unit": "seconds"
      },
      "placed_on_asleep_or_waking_server_pct": {
        "definition": "Category placements on asleep or waking hosts.",
        "unit": "percent"
      }
    },
    "resource_skew_scope": "D5 primary LR-MMT pair only; no category energy allocation.",
    "run_metrics": {
      "completed_instances": {
        "definition": "Completed independent instances, not task groups.",
        "unit": "instances"
      },
      "drain_time_s": {
        "definition": "Simulation time beyond the arrival horizon.",
        "unit": "seconds"
      },
      "energy_kwh": {
        "definition": "Modeled whole-cluster energy, including sleep and wake power.",
        "unit": "kWh"
      },
      "max_wait_s": {
        "definition": "Maximum initial instance wait.",
        "unit": "seconds"
      },
      "mean_active_hosts": {
        "definition": "Time-weighted powered hosts, including waking hosts.",
        "unit": "hosts"
      },
      "mean_fragmentation_index": {
        "definition": "Event-integrated normalized residual-resource fragmentation index.",
        "unit": "fraction"
      },
      "mean_wait_s": {
        "definition": "Instance-weighted initial wait, including queueing and wake delay.",
        "unit": "seconds"
      },
      "migration_pause_instance_seconds": {
        "definition": "Sum of instance pauses, including destination wake delay.",
        "unit": "instance-seconds"
      },
      "migrations": {
        "definition": "Number of stop-and-copy migrations.",
        "unit": "transfers"
      },
      "overload_host_time_fraction": {
        "definition": "Modeled SLA proxy: CPU-or-memory reservation pressure above the configured threshold; not measured SLA violations.",
        "unit": "fraction"
      },
      "p95_turnaround_s": {
        "definition": "Within-run 95th percentile of completion minus release.",
        "unit": "seconds"
      },
      "p95_wait_s": {
        "definition": "Within-run 95th percentile; never average across runs or categories.",
        "unit": "seconds"
      },
      "peak_active_hosts": {
        "definition": "Maximum number of powered hosts, including waking hosts.",
        "unit": "hosts"
      },
      "queue_instance_seconds": {
        "definition": "Queue time before dispatch, excluding subsequent wake delay.",
        "unit": "instance-seconds"
      },
      "rejected_instances": {
        "definition": "Offered instances rejected by the simulator.",
        "unit": "instances"
      },
      "stop_time_s": {
        "definition": "Maximum of arrival horizon and final completion.",
        "unit": "seconds"
      },
      "unfinished_instances": {
        "definition": "Arrived instances neither completed nor rejected at the stopping rule.",
        "unit": "instances"
      },
      "wh_per_completed_instance": {
